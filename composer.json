{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "iqbalfhz/nadi",
    "type": "project",
    "description": "NADI, sistem operasional kantor terpadu.",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "bezhansalleh/filament-shield": "^4.3.1",
        "endroid/qr-code": "^6.2",
        "filament/filament": "^5.11.4",
        "filament/spatie-laravel-media-library-plugin": "^5.11.4",
        "filament/spatie-laravel-settings-plugin": "^5.11.4",
        "guava/calendar": "^3.2.2",
        "laravel/fortify": "^1.43.0",
        "laravel/framework": "^13.43",
        "laravel/reverb": "^1.14",
        "laravel/sanctum": "^4.5",
        "laravel/tinker": "^3.2",
        "livewire/blaze": "^1.0.21",
        "livewire/flux": "^2.22.0",
        "livewire/livewire": "^4.4.8",
        "masbug/flysystem-google-drive-ext": "^2.6",
        "picqer/php-barcode-generator": "^3.3.1",
        "pxlrbt/filament-excel": "^4.1.2",
        "spatie/laravel-activitylog": "^5.1.5",
        "spatie/laravel-backup": "^10.5"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.15",
        "laravel/boost": "^2.10.4",
        "laravel/pail": "^1.3.0",
        "laravel/pao": "^1.1.6",
        "laravel/pint": "^1.32.3",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.6",
        "phpunit/phpunit": "^12.5.45"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names='server,queue,vite'"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@test"
        ],
        "types:check": [
            "phpstan analyse --memory-limit=2G"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan boost:update --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5.13"
        },
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
